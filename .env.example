# TX Limited Environment Configuration
PORT=8080

# Host-based routing domains (no protocol, no port)
PUBLIC_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost

# PostgreSQL connection
DATABASE_URL=postgresql://tx_user:tx_pass@localhost:5432/tx_limited

# Admin Console authentication & host-only session secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tx_admin_pass
SESSION_SECRET=change-this-to-a-long-random-secret-in-production
